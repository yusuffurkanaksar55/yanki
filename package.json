{
  "name": "anonymous-evaluation-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:install": "playwright install chromium",
    "e2e:local": "node scripts/run-local-e2e.mjs",
    "e2e:container:local": "node scripts/run-local-e2e.mjs --container",
    "memory:trim": "node scripts/trim-project-memory.mjs",
    "memory:check": "node scripts/trim-project-memory.mjs --check",
    "deployment:config": "node scripts/validate-compose-config.mjs",
    "release:validate-tag": "node scripts/prepare-container-release.mjs --validate-tag",
    "release:prepare": "node scripts/prepare-container-release.mjs",
    "release:checksums": "node scripts/create-release-checksums.mjs",
    "release:acceptance": "node scripts/verify-release-installation.mjs",
    "backup:restore:acceptance": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.operator.local scripts/verify-backup-restore-acceptance.mjs",
    "backup:tool:install": "node scripts/install-restic-local-tool.mjs",
    "backup:offsite:init": "node --env-file-if-exists=.env.operator.local scripts/initialize-offsite-backup-repository.mjs",
    "backup:offsite:create": "node --env-file-if-exists=.env.operator.local scripts/create-encrypted-offsite-backup.mjs",
    "backup:offsite:check": "node --env-file-if-exists=.env.operator.local scripts/check-encrypted-offsite-backup.mjs",
    "backup:offsite:retention": "node --env-file-if-exists=.env.operator.local scripts/apply-encrypted-offsite-backup-retention.mjs",
    "backup:offsite:restore:acceptance": "node --env-file-if-exists=.env.operator.local scripts/verify-offsite-backup-restore-acceptance.mjs",
    "encryption:key:prepare": "node scripts/prepare-encryption-key-rotation.mjs",
    "encryption:custody:validate": "node --env-file-if-exists=.env.operator.local scripts/validate-encryption-key-custody.mjs",
    "encryption:recovery:canary": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.operator.local scripts/provision-encryption-recovery-canaries.mjs",
    "encryption:recovery:acceptance": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.operator.local scripts/verify-key-database-recovery-acceptance.mjs",
    "retention:run": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.operator.local scripts/run-evaluation-retention.mjs",
    "security:alerts:check": "node --env-file-if-exists=.env.operator.local scripts/check-security-alerts.mjs",
    "security:alerts:acceptance": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.operator.local scripts/verify-security-alert-acceptance.mjs",
    "tenant:bootstrap:check": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.operator.local scripts/bootstrap-production-tenant.mjs --check",
    "tenant:bootstrap": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.operator.local scripts/bootstrap-production-tenant.mjs",
    "tenant:bootstrap:recover": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.operator.local scripts/bootstrap-production-tenant.mjs --recover",
    "fixture:demo": "node scripts/create-demo-fixture.mjs",
    "smoke:hierarchy": "node scripts/smoke-hierarchy-administration.mjs",
    "smoke:assignments": "node --env-file-if-exists=.env.local scripts/smoke-employee-assignment-access.mjs",
    "smoke:submissions": "node --env-file-if-exists=.env.local scripts/smoke-anonymous-evaluation-submission.mjs",
    "smoke:abuse": "node --env-file-if-exists=.env.local scripts/smoke-anonymous-evaluation-submission.mjs",
    "smoke:reports": "node --env-file-if-exists=.env.local scripts/smoke-thresholded-evaluation-reporting.mjs",
    "smoke:key-health": "node --env-file-if-exists=.env.local scripts/smoke-encryption-key-health.mjs",
    "smoke:retention": "node --env-file-if-exists=.env.local scripts/smoke-evaluation-retention.mjs",
    "smoke:templates": "node --env-file-if-exists=.env.local scripts/smoke-versioned-evaluation-templates.mjs",
    "smoke:project-dates": "node scripts/smoke-project-date-administration.mjs",
    "supabase:migrations": "npx supabase migration list",
    "supabase:lint:linked": "npx supabase db lint --linked",
    "supabase:lint:local": "npx supabase db lint --local",
    "supabase:push:dry-run": "npx supabase db push --dry-run",
    "supabase:test:local": "npx supabase test db",
    "supabase:types": "npx supabase gen types typescript --linked > src/types/supabase.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run memory:check"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "lucide-react": "^1.31.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "pg": "^8.23.0",
    "postcss": "^8.5.19",
    "supabase": "^2.109.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
