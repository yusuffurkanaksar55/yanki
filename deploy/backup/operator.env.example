BACKUP_RESTIC_COMMAND=/usr/local/bin/restic
BACKUP_ENVIRONMENT_ID=customer-production
BACKUP_SOURCE_MODE=DATABASE_URL
BACKUP_DATABASE_URL=postgresql://replace-with-server-only-connection
RESTIC_REPOSITORY=s3:s3.example.com/yanki-encrypted-backups
RESTIC_PASSWORD_FILE=/run/secrets/yanki-restic-password
AWS_ACCESS_KEY_ID=replace-through-approved-secret-channel
AWS_SECRET_ACCESS_KEY=replace-through-approved-secret-channel
OFFSITE_BACKUP_REPOSITORY_INIT_CONFIRM=INITIALIZE_ENCRYPTED_OFFSITE_REPOSITORY
OFFSITE_BACKUP_CREATE_CONFIRM=CREATE_ENCRYPTED_OFFSITE_BACKUP
OFFSITE_BACKUP_RETENTION_CONFIRM=APPLY_ENCRYPTED_OFFSITE_RETENTION
BACKUP_CHECK_READ_DATA_SUBSET=5%
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=6
BACKUP_KEEP_YEARLY=0
