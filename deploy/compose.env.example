# Public values delivered to the browser at container startup.
SUPABASE_PUBLIC_URL=https://supabase.customer.example
SUPABASE_ANON_KEY=replace-with-customer-public-anon-or-publishable-key

# Bind locally when a TLS reverse proxy runs on the same server.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
YANKI_IMAGE=yanki-web:local
