# Public same-origin gateway URL delivered to the browser at container startup.
SUPABASE_PUBLIC_URL=https://app.customer.example/supabase
SUPABASE_ANON_KEY=replace-with-customer-public-anon-or-publishable-key

# Public or private Supabase origin used only by the Nginx gateway.
SUPABASE_UPSTREAM_URL=https://supabase.customer.example
YANKI_SENSITIVE_GATEWAY_TOKEN=replace-with-at-least-32-random-characters

# Bind locally when a TLS reverse proxy runs on the same server.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
YANKI_IMAGE=yanki-web:local
