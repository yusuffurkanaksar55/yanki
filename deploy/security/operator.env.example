SUPABASE_URL=https://supabase.customer.example
SUPABASE_SERVICE_ROLE_KEY=replace-through-approved-secret-channel
SECURITY_ALERT_ENVIRONMENT_ID=customer-production
SECURITY_ALERT_WEBHOOK_URL=https://alerts.customer.example/hooks/yanki
SECURITY_ALERT_WEBHOOK_BEARER_TOKEN_FILE=/run/secrets/yanki-security-alert-webhook-token
SECURITY_ALERT_STATE_PATH=/var/lib/yanki-security-alert/state.json
SECURITY_ALERT_INVALID_60M_THRESHOLD=60
SECURITY_ALERT_RATE_LIMITED_60M_THRESHOLD=5
SECURITY_ALERT_REMINDER_MINUTES=1440
SECURITY_ALERT_DELIVERY_CONFIRM=DELIVER_CONTENT_FREE_SECURITY_ALERTS
